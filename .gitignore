.myvenv

# Terraform
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. Keep .tfvars.example files.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# means they might not be regarded as part of the true codebase.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override.example.tf files
!override.example.tf
!override.example.tf.json

# Ignore CLI config files
.terraformrc
terraform.rc

# Ignore plan files (may contain sensitive unencrypted state data)
*.tfplan
*.plan
